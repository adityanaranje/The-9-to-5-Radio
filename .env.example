# YouTube playlist IDs per station (the value after `list=` in a playlist URL).
# These use the NEXT_PUBLIC_ prefix so they're available to the browser at build time.
# Leave blank for a "coming soon" state.

NEXT_PUBLIC_PLAYLIST_CHAI_BREAK_FM=
NEXT_PUBLIC_PLAYLIST_CODE_COFFEE=
NEXT_PUBLIC_PLAYLIST_OFFICE_COMMUTE=
NEXT_PUBLIC_PLAYLIST_MONDAY_SURVIVAL=
NEXT_PUBLIC_PLAYLIST_DEEP_WORK_FM=
NEXT_PUBLIC_PLAYLIST_DEADLINE_MODE=
NEXT_PUBLIC_PLAYLIST_POST_LUNCH_FM=
NEXT_PUBLIC_PLAYLIST_FRIDAY_5PM=
NEXT_PUBLIC_PLAYLIST_SALARY_CREDITED_FM=
NEXT_PUBLIC_PLAYLIST_WFH_RADIO=
NEXT_PUBLIC_PLAYLIST_LATE_NIGHT_DEPLOYMENT=
NEXT_PUBLIC_PLAYLIST_LEAVE_APPROVED_FM=
NEXT_PUBLIC_PLAYLIST_APPRAISAL_SEASON=
NEXT_PUBLIC_PLAYLIST_NOTICE_PERIOD_FM=
NEXT_PUBLIC_PLAYLIST_CORPORATE_BURNOUT_FM=
NEXT_PUBLIC_PLAYLIST_MONSOON_DESK_FM=

# Your LinkedIn profile URL (used for the small LinkedIn icon in the site footer).
# NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/your-handle

# Optional: YouTube Data API key if you want real playlist track titles.
# YOUTUBE_DATA_API_KEY=
